# Copy this file to .env and fill in your values
# Never commit .env to git

# GitHub personal access token (repo read scope is enough)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# GitHub repo to fetch issues from
GITHUB_REPO=applydigital/ai-engineering

# --- Jira (for fetch-jira-ticket) ---
# Base URL of your Jira Cloud instance (no trailing slash)
JIRA_BASE_URL=https://your-org.atlassian.net

# Your Atlassian account email
JIRA_EMAIL=you@applydigital.com

# API token — create one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_token_here
